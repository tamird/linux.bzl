load("@bazel_skylib//lib:shell.bzl", "shell")
load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load("@rules_python//python:defs.bzl", "py_test")
load("//rules:compiler.bzl", "kernel_compiler")
load("//rules:compiler_test.bzl", "action_built_compiler", "action_built_toolchain_config")
load("//rules:config.bzl", "kernel_config")
load("//rules:parity.bzl", "configured_report")

package(default_visibility = ["//visibility:public"])

exports_files([
    "repository.bzl",
    "test_config_values.py",
    "probe_runtime.py",
    "compare_upstream.py",
    "execute.py",
    "scheduler.py",
    "emit.py",
])

alias(
    name = "compiler",
    actual = "//native:compiler",
)

alias(
    name = "config",
    actual = "//native:config",
)

alias(
    name = "allno_config",
    actual = "//native:config",
)

alias(
    name = "custom_config",
    actual = "//native:custom_config",
)

constraint_setting(name = "compiler_origin")

constraint_value(
    name = "action_built",
    constraint_setting = ":compiler_origin",
)

platform(
    name = "action_built_platform",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":action_built",
    ],
)

action_built_compiler(
    name = "compiler_driver",
    src = "//tests:compiler_driver.c",
    tags = ["manual"],
)

action_built_toolchain_config(
    name = "driver_toolchain_config",
    driver = ":compiler_driver",
    tags = ["manual"],
)

cc_toolchain(
    name = "driver_cc_toolchain",
    all_files = ":compiler_driver",
    ar_files = ":compiler_driver",
    as_files = ":compiler_driver",
    compiler_files = ":compiler_driver",
    dwp_files = ":compiler_driver",
    linker_files = ":compiler_driver",
    objcopy_files = ":compiler_driver",
    strip_files = ":compiler_driver",
    supports_param_files = 0,
    tags = ["manual"],
    toolchain_config = ":driver_toolchain_config",
    toolchain_identifier = "action-built-compiler-test",
)

toolchain(
    name = "driver_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    tags = ["manual"],
    target_compatible_with = [
        ":action_built",
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = ":driver_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

kernel_compiler(
    name = "driver_compiler",
    assembler_flags = ["-fintegrated-as"],
    builtin_headers = "//native:llvm_builtin_headers",
    tags = ["manual"],
    tools = {"@llvm//tools:llvm-readelf": "READELF"},
)

kernel_config(
    name = "action_built_config",
    compiler = ":driver_compiler",
    fragments = ["//examples/configs:x86_64.config"],
    pahole = "@pahole//:pahole",
    source = "//native:source",
    tags = ["manual"],
)

configured_report(
    name = "action_built_report",
    platform = ":action_built_platform",
    report = ":action_built_config",
    tags = ["manual"],
)

py_test(
    name = "action_built_config_test",
    srcs = ["test_config_values.py"],
    args = [
        "$(rootpath :action_built_report)",
        shell.quote(json.encode({
            "X86": "y",
            "64BIT": "y",
            "CC_IS_CLANG": "y",
        })),
        "--compiler-suffix=/compiler_driver",
    ],
    data = [":action_built_report"],
    main = "test_config_values.py",
    tags = ["manual"],
)

py_test(
    name = "execute_test",
    srcs = [
        "execute.py",
        "test_execute.py",
    ],
    main = "test_execute.py",
)

py_test(
    name = "generation_test",
    srcs = [
        "renderer/export.py",
        "renderer/programs.py",
        "renderer/syntax.py",
        "test_generation.py",
    ],
    imports = ["renderer"],
    main = "test_generation.py",
)

py_test(
    name = "reuse_report_test",
    srcs = [
        "check_reuse.py",
        "test_reuse.py",
    ],
    main = "test_reuse.py",
)

filegroup(
    name = "generator_sources",
    srcs = [
        "build.py",
        "launcher.c",
        "test_repository.py",
        "//native:generator_sources",
    ] + glob(
        [
            "renderer/**",
        ],
        exclude = ["**/__pycache__/**"],
    ),
)

py_test(
    name = "prototype_test",
    srcs = [
        "prototype_test.py",
        "renderer/export.py",
        "renderer/repository_main.py",
    ],
    args = [
        "--initramfs",
        "$(rootpath //examples:initramfs.py)",
        "--config-anchor",
        "$(rootpath //examples/configs:x86_64.config)",
    ],
    data = ["//examples:initramfs.py"] + ["//examples/configs:" + name + ".config" for name in [
        "x86_64",
        "aarch64",
        "debug",
        "btf",
        "lz4",
    ]],
    imports = ["renderer"],
)

buildifier(
    name = "buildifier",
    exclude_patterns = ["*/[._]*"],
    lint_mode = "fix",
    mode = "fix",
)

buildifier_test(
    name = "buildifier_test",
    exclude_patterns = ["*/[._]*"],
    lint_mode = "warn",
    lint_warnings = [
        "-module-docstring",
        "-function-docstring-args",
        "-function-docstring",
        "-function-docstring-header",
        "-function-docstring-return",
    ],
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

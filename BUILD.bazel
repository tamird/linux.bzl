load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//:renderer/pahole.bzl", "kernel_pahole", "kernel_pahole_test")
load("//native:bootstrap.bzl", "kernel_repository_bootstrap", "make_parser")

package(default_visibility = ["//visibility:public"])

kernel_pahole(
    name = "pahole",
    binary = "@pahole//:pahole",
    tags = ["manual"],
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

kernel_pahole_test(
    name = "pahole_test",
    pahole = ":pahole",
    target_compatible_with = ["@platforms//os:linux"],
)

exports_files([
    "build.py",
    "linux.bzl",
    "repository.bzl",
    "launcher.c",
    "test_repository.py",
    "renderer/rules_bison_cstdlib.patch",
    "renderer/rules_cc_autoconf_no_host_shell.patch",
])

py_library(
    name = "compiler_capability_support",
    srcs = ["renderer/compiler_capabilities.py"],
    data = ["renderer/compiler_capabilities.json"],
    imports = ["renderer"],
)

py_binary(
    name = "bootstrap_builder",
    srcs = ["build.py"],
    main = "build.py",
)

make_parser(
    name = "make_parser",
    tags = ["manual"],
    exports = ["//native:" + name for name in [
        "ast_export.inc",
        "expr_export.inc",
        "setup_export.inc",
    ]],
)

filegroup(
    name = "renderer",
    srcs = glob(
        ["renderer/*"],
        exclude = ["**/__pycache__/**"],
    ),
)

kernel_repository_bootstrap(source_repository = "@bootstrap_linux")

filegroup(
    name = "generator_sources",
    srcs = [
        "build.py",
        "example.py",
        "launcher.c",
        "test_repository.py",
        "//native:sources",
    ] + glob(
        [
            "renderer/**",
        ],
        exclude = ["**/__pycache__/**"],
    ),
)

py_test(
    name = "prototype_test",
    srcs = [
        "prototype_test.py",
        "renderer/export.py",
        "renderer/repository_main.py",
    ],
    args = [
        "--initramfs",
        "$(rootpath @example_fixtures//:initramfs.py)",
        "--config-anchor",
        "$(rootpath @example_fixtures//configs:x86_64.config)",
    ],
    data = ["@example_fixtures//:initramfs.py"] + ["@example_fixtures//configs:" + name + ".config" for name in [
        "x86_64",
        "aarch64",
        "debug",
        "btf",
        "lz4",
    ]],
    imports = ["renderer"],
)

buildifier(
    name = "buildifier",
    exclude_patterns = ["*/[._]*"],
    lint_mode = "fix",
    mode = "fix",
)

buildifier_test(
    name = "buildifier_test",
    exclude_patterns = ["*/[._]*"],
    lint_mode = "warn",
    lint_warnings = [
        "-module-docstring",
        "-function-docstring-args",
        "-function-docstring",
        "-function-docstring-header",
        "-function-docstring-return",
    ],
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

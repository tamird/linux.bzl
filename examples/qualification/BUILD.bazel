load("@kernel//rules:example_configs.bzl", "EXAMPLE_CONFIGS")
load("@kernel//rules:image.bzl", "kbuild_ir_experiment")
load("@kernel//rules:rules.bzl", "kernel_config")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":ir_experiment.bzl", "ir_variant")
load(":native_conf.bzl", "native_conf", "native_config_reference")

exports_files([
    "native_reference.py",
    "rules_cc_ir.patch",
])

_CASES = {
    "base": ("x86_64_kernel", "x86_64"),
    "debug": ("x86_64_debug_kernel", "x86_64"),
    "lz4": ("x86_64_lz4_kernel", "x86_64"),
    "btf": ("x86_64_btf_vmlinux", "x86_64"),
    "arm64": ("aarch64_kernel", "aarch64"),
}

# The source list follows scripts/kconfig/Makefile's conf-objs/common-objs.
# The native parser, preprocessor and semantic implementation are unmodified.
native_conf(
    name = "conf",
    srcs = ["@kernel//:source/scripts/kconfig/" + name + ".c" for name in [
        "conf",
        "confdata",
        "expr",
        "menu",
        "preprocess",
        "symbol",
        "util",
    ]],
    hdrs = ["@kernel//:source/scripts/kconfig/" + name + ".h" for name in [
        "expr",
        "internal",
        "lkc",
        "lkc_proto",
        "preprocess",
    ]] + ["@kernel//:source/scripts/include/" + name + ".h" for name in [
        "array_size",
        "hash",
        "hashtable",
        "list",
        "list_types",
        "xalloc",
    ]],
    include_anchor = "@kernel//:source/scripts/include/xalloc.h",
    lexer = "@kernel//:source/scripts/kconfig/lexer.l",
    parser = "@kernel//:source/scripts/kconfig/parser.y",
)

[
    native_config_reference(
        name = name + "_native",
        conf = ":conf",
        config = "//:" + target + "_requested",
        platform = "@llvm//platforms:linux_" + arch,
    )
    for name, (target, arch) in _CASES.items()
]

[
    py_test(
        name = name + "_parity",
        srcs = ["parity_test.py"],
        args = ["$(rootpath :" + name + "_native)"],
        data = [":" + name + "_native"],
        main = "parity_test.py",
    )
    for name in _CASES
]

test_suite(
    name = "parity",
    tests = [":" + name + "_parity" for name in _CASES],
)

py_binary(
    name = "reuse_report",
    srcs = ["reuse_report.py"],
)

py_test(
    name = "reuse_report_test",
    srcs = [
        "reuse_report.py",
        "reuse_report_test.py",
    ],
)

kbuild_ir_experiment(
    name = "ir_core",
    catalog = "@kernel//:catalog",
    roots = [
        "init/main.o",
        "kernel/fork.o",
        "kernel/panic.o",
        "kernel/exit.o",
        "lib/string.o",
        "lib/ctype.o",
        "arch/x86/boot/string.o",
    ],
    tags = ["manual"],
)

kernel_config(
    name = "ir_changed_config",
    allnoconfig = True,
    base = EXAMPLE_CONFIGS["x86_64"],
    options = "@kernel//options:options",
    requested = {"PANIC_TIMEOUT": "37"},
    tags = ["manual"],
)

[
    ir_variant(
        name = "ir_" + name,
        config = config,
        required_options = {"PANIC_TIMEOUT": "37" if name == "changed" else "0"},
        tags = ["manual"],
        target = ":ir_core",
    )
    for name, config in {
        "base": "//:x86_64_kernel_requested",
        "lz4": "//:x86_64_lz4_kernel_requested",
        "changed": ":ir_changed_config",
    }.items()
]

py_test(
    name = "ir_compare_test",
    srcs = ["ir_compare.py"],
    args = ["$(rootpath :ir_" + name + ")" for name in [
        "base",
        "lz4",
        "changed",
    ]],
    data = [":ir_" + name for name in [
        "base",
        "lz4",
        "changed",
    ]],
    main = "ir_compare.py",
    tags = ["manual"],
)

py_binary(
    name = "ir_reuse_report",
    srcs = [
        "ir_reuse_report.py",
        "reuse_report.py",
    ],
)

load("@kernel//rules:example_configs.bzl", "EXAMPLE_CONFIGS")
load(":kernel.bzl", "btf_capability_test", "example_config_test", "example_initramfs", "kernel_btf_test", "kernel_example")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".generated/rules_bison_cstdlib.patch",
    ".generated/rules_cc_autoconf_no_host_shell.patch",
])

example_initramfs(
    name = "example_initramfs",
    motd = "README.md",
)

kernel_example(
    name = "x86_64_kernel",
    architecture_roots = {"x86": ["arch/x86/boot/bzImage"]},
    platform = "@llvm//platforms:linux_x86_64",
    requested = EXAMPLE_CONFIGS["x86_64"],
)

kernel_example(
    name = "x86_64_debug_kernel",
    overrides = EXAMPLE_CONFIGS["debug"],
    platform = "@llvm//platforms:linux_x86_64",
    requested = EXAMPLE_CONFIGS["x86_64"],
)

kernel_example(
    name = "x86_64_lz4_kernel",
    architecture_roots = {"x86": ["arch/x86/boot/bzImage"]},
    overrides = EXAMPLE_CONFIGS["lz4"],
    platform = "@llvm//platforms:linux_x86_64",
    requested = EXAMPLE_CONFIGS["x86_64"],
)

# A BTF request without a declared encoder must fail during analysis.
kernel_example(
    name = "x86_64_btf_vmlinux",
    overrides = EXAMPLE_CONFIGS["btf"],
    platform = "@llvm//platforms:linux_x86_64",
    requested = EXAMPLE_CONFIGS["x86_64"],
    required_options = {"DEBUG_INFO_BTF": "y"},
    tags = ["manual"],
)

kernel_example(
    name = "x86_64_btf_declared",
    overrides = EXAMPLE_CONFIGS["btf"],
    pahole = "@kernel//:pahole",
    platform = "@llvm//platforms:linux_x86_64",
    requested = EXAMPLE_CONFIGS["x86_64"],
    required_options = {"DEBUG_INFO_BTF": "y"},
    tags = ["manual"],
)

example_config_test(
    name = "btf_declared_config_test",
    config = ":x86_64_btf_declared_config",
    expected = {"DEBUG_INFO_BTF": "y"},
)

kernel_example(
    name = "aarch64_kernel",
    platform = "@llvm//platforms:linux_aarch64",
    requested = EXAMPLE_CONFIGS["aarch64"],
)

kernel_example(
    name = "aarch64_btf_declared",
    architecture_roots = {"arm64": ["arch/arm64/boot/Image"]},
    overrides = EXAMPLE_CONFIGS["btf"],
    pahole = "@kernel//:pahole",
    platform = "@llvm//platforms:linux_aarch64",
    requested = EXAMPLE_CONFIGS["aarch64"],
    required_options = {"DEBUG_INFO_BTF": "y"},
    tags = ["manual"],
)

kernel_btf_test(
    name = "aarch64_btf_image_test",
    kernel = ":aarch64_btf_declared",
    tags = ["manual"],
)

MODULE_OPTIONS = dict(
    EXAMPLE_CONFIGS["btf"],
    INET = "y",
    MODULES = "y",
    NET = "y",
    NET_CLS_ACT = "y",
    NET_SCHED = "y",
    NET_SCH_INGRESS = "m",
)

MODULE_REQUIRED_OPTIONS = {
    "DEBUG_INFO_BTF": "y",
    "MODULES": "y",
    "NET_SCH_INGRESS": "m",
}

kernel_example(
    name = "aarch64_modules",
    architecture_roots = {"arm64": ["arch/arm64/boot/Image"]},
    modules = ["net/sched/sch_ingress.ko"],
    overrides = MODULE_OPTIONS,
    pahole = "@kernel//:pahole",
    platform = "@llvm//platforms:linux_aarch64",
    requested = EXAMPLE_CONFIGS["aarch64"],
    required_options = MODULE_REQUIRED_OPTIONS,
    tags = ["manual"],
)

kernel_btf_test(
    name = "aarch64_modules_btf_test",
    kernel = ":aarch64_modules",
    tags = ["manual"],
)

kernel_example(
    name = "x86_64_modules",
    architecture_roots = {"x86": ["arch/x86/boot/bzImage"]},
    modules = ["net/sched/sch_ingress.ko"],
    overrides = MODULE_OPTIONS,
    pahole = "@kernel//:pahole",
    platform = "@llvm//platforms:linux_x86_64",
    requested = EXAMPLE_CONFIGS["x86_64"],
    required_options = MODULE_REQUIRED_OPTIONS,
    tags = ["manual"],
)

kernel_btf_test(
    name = "x86_64_modules_btf_test",
    kernel = ":x86_64_modules",
    tags = ["manual"],
)

filegroup(
    name = "x86_64_shared_graph_metadata",
    srcs = [":x86_64_kernel"],
    output_group = "manifest",
)

example_config_test(
    name = "x86_64_config_test",
    config = ":x86_64_kernel_config",
    expected = {
        "X86": "y",
        "64BIT": "y",
        "MODULES": "n",
    },
)

example_config_test(
    name = "aarch64_config_test",
    config = ":aarch64_kernel_config",
    expected = {
        "ARM64": "y",
        "64BIT": "y",
        "MODULES": "n",
    },
)

example_config_test(
    name = "debug_config_test",
    config = ":x86_64_debug_kernel_config",
    expected = {
        "DEBUG_KERNEL": "y",
        "LOCALVERSION": '"-debug"',
        "RANDOMIZE_BASE": "n",
    },
)

example_config_test(
    name = "lz4_config_test",
    config = ":x86_64_lz4_kernel_config",
    expected = {
        "KERNEL_LZ4": "y",
        "KERNEL_GZIP": "n",
    },
)

btf_capability_test(
    name = "btf_capability_test",
    target_under_test = ":x86_64_btf_vmlinux",
)

load(":defs.bzl", "kernel_execution_tools")

package(default_visibility = ["//visibility:public"])

toolchain_type(name = "toolchain_type")

kernel_execution_tools(
    name = "linux_x86_64_tools",
    commands = {
        "@kernel_exec_bash_linux_x86_64//file": "sh bash",
        "@gawk//:gawk": "awk",
        "@sed//:sed": "sed",
        "@grep//:grep": "grep",
        "@make//:make": "make",
    },
    coreutils = "basename cat chmod cmp cp cut date dirname echo env expr false head ln mkdir mktemp mv printf pwd readlink realpath rm sleep sort stat tail test touch tr true uname uniq wc".split(" "),
)

toolchain(
    name = "linux_x86_64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":linux_x86_64_tools",
    toolchain_type = ":toolchain_type",
)

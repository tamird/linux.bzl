package(default_visibility = ["//visibility:public"])

exports_files([
    "Makefile",
    "COPYING",
    "LICENSES/preferred/GPL-2.0",
])

filegroup(
    name = "kconfig",
    srcs = glob([
        "scripts/kconfig/*.c",
        "scripts/kconfig/*.h",
        "scripts/kconfig/*.l",
        "scripts/kconfig/*.y",
    ]) + glob(["scripts/include/**/*.h"], allow_empty = True),
)

filegroup(
    name = "configuration",
    srcs = glob(["**/Kconfig*"]),
)

filegroup(
    name = "sources",
    srcs = glob(["**"], exclude = [".git/**"]),
)

load("@rules_python//python:defs.bzl", "py_binary")
load(":bootstrap.bzl", "generator_execution")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_x86_64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@llvm//constraints/libc:musl",
    ],
)

# Support generation executes the target binary, so its execution platform must
# match that binary even when the C++ toolchain also supports cross-compilation.
toolchain_type(name = "generator_execution_toolchain_type")

generator_execution(name = "generator_execution")

[
    toolchain(
        name = "generator_execution_" + name,
        exec_compatible_with = constraints,
        target_compatible_with = constraints,
        toolchain = ":generator_execution",
        toolchain_type = ":generator_execution_toolchain_type",
    )
    for name, constraints in {
        "linux_x86_64": [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
        "macos_aarch64": [
            "@platforms//os:macos",
            "@platforms//cpu:aarch64",
        ],
    }.items()
]

config_setting(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

exports_files(glob([
    "*.BUILD.bazel",
    "*.bzl",
    "*.patch",
    "*.inc",
    "*.c",
]))

py_binary(
    name = "prepare",
    srcs = ["prepare.py"],
    data = [
        "dump.c",
        "kconfig_fallback.inc",
        "kconfig_syntax.inc",
    ],
    deps = ["//:compiler_capability_support"],
)

filegroup(
    name = "sources",
    srcs = glob(["*"]),
)

Allow Linux freestanding actions to exclude injected system headers.

The opt-in feature preserves compiler resource headers and does not alter
default hosted compilation or runtime-stage selection.

diff --git a/toolchain/features/BUILD.bazel b/toolchain/features/BUILD.bazel
--- a/toolchain/features/BUILD.bazel
+++ b/toolchain/features/BUILD.bazel
@@ -1,6 +1,7 @@
 load("@bazel_skylib//lib:selects.bzl", "selects")
 load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
 load("@rules_cc//cc/toolchains:feature.bzl", "cc_feature")
+load("@rules_cc//cc/toolchains:feature_constraint.bzl", "cc_feature_constraint")
 load("@rules_cc//cc/toolchains:feature_set.bzl", "cc_feature_set")
 load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")
 
@@ -43,6 +44,18 @@
 # [] dynamic_linking_mode
 # [x] per_object_debug_info
 # [x] static_link_cpp_runtimes
+
+# Freestanding Linux clients supply their own system headers. Compiler
+# resource headers remain controlled by the driver's native include flags.
+cc_feature(
+    name = "no_linux_system_includes",
+    feature_name = "no_linux_system_includes",
+)
+
+cc_feature_constraint(
+    name = "linux_system_includes",
+    none_of = [":no_linux_system_includes"],
+)
 
 cc_feature(
     name = "static_link_cpp_runtimes",
